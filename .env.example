# Copy this file to .env and fill in your Supabase project values
# (Supabase dashboard -> Project Settings -> API).
# Use the PUBLISHABLE / anon key only. NEVER put the service_role (secret) key here:
# everything starting with VITE_ is visible to anyone who opens the game.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
